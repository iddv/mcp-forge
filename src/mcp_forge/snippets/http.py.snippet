
# --- mcp-forge:http ---
# Streamable HTTP transport: run `python server.py --http` and connect clients
# to http://127.0.0.1:8000/mcp. A /health route is added for load balancers.
# See: https://modelcontextprotocol.io/specification/latest/basic/transports
from starlette.requests import Request
from starlette.responses import JSONResponse


@mcp.custom_route("/health", methods=["GET"])
async def health(request: Request) -> JSONResponse:
    return JSONResponse({"status": "ok"})
