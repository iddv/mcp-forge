
# --- mcp-forge:resources ---
# Resources expose data that clients can read.
# See: https://modelcontextprotocol.io/specification/latest/server/resources


@mcp.resource(
    "config://app",
    title="App configuration",
    description="Application configuration",
    mime_type="application/json",
)
def get_config() -> str:
    """Return application configuration as JSON."""
    import json

    config = {
        "version": "0.1.0",
        "debug": False,
        "log_level": "info",
    }
    return json.dumps(config, indent=2)
