
# --- mcp-forge:auth ---
# OAuth 2.1 resource server: the server validates bearer tokens issued by an
# external authorization server and advertises it via Protected Resource
# Metadata (RFC 9728). Auth only applies to the HTTP transport (--http).
# See: https://modelcontextprotocol.io/specification/latest/basic/authorization
import os
import secrets

from mcp.server.auth.provider import AccessToken, TokenVerifier
from mcp.server.auth.settings import AuthSettings

AUTH_ISSUER_URL = os.environ.get("MCP_AUTH_ISSUER_URL", "https://auth.example.com")
RESOURCE_SERVER_URL = os.environ.get("MCP_RESOURCE_SERVER_URL", "http://127.0.0.1:8000/mcp")


class EnvTokenVerifier(TokenVerifier):
    """Development verifier: accepts the static token in $MCP_API_TOKEN.

    Replace verify_token with JWT validation or token introspection against
    your authorization server before going to production.
    """

    async def verify_token(self, token: str) -> AccessToken | None:
        expected = os.environ.get("MCP_API_TOKEN")
        if not expected or not secrets.compare_digest(token, expected):
            return None
        return AccessToken(
            token=token,
            client_id="dev-client",
            scopes=["mcp:tools"],
            resource=RESOURCE_SERVER_URL,
        )
