
# --- mcp-forge:context ---
# The Context object gives tools progress reporting and request metadata.
# MCP protocol logging is deprecated (2026-07-28), so log with the stdlib
# logger (stderr) and report progress to the client instead.
# See: https://modelcontextprotocol.io/specification/latest/basic/utilities/progress
import asyncio
import logging

from mcp.server.mcpserver import Context

logger = logging.getLogger("{{name}}")


@mcp.tool()
async def process_data(items: list[str], ctx: Context) -> str:
    """Process a list of items with progress reporting and logging."""
    total = len(items)
    logger.info("Processing %d items (request %s)", total, ctx.request_id)

    results = []
    for i, item in enumerate(items, start=1):
        # Simulate work
        await asyncio.sleep(0.1)
        results.append(item.upper())
        await ctx.report_progress(i, total, f"Processed: {item}")

    logger.info("Finished processing %d items", total)
    return f"Processed {total} items: {', '.join(results)}"
